# ─── Workspace Agent (set these in Replit Secrets) ───────────────────────────
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPLBRIDGE_PROJECT_TOKEN=replace-with-a-secure-random-token
REPLBRIDGE_WORKSPACE_ROOT=/home/runner/workspace
# Optional: extra exact commands to allow, comma-separated
# REPLBRIDGE_EXTRA_COMMANDS=npx tsc --noEmit,npm run e2e

# ─── MCP Server (set these in your MCP client config, or packages/mcp-server/.env)
REPLBRIDGE_AGENT_URL=https://your-repl-dev-url.replit.dev
# REPLBRIDGE_PROJECT_TOKEN must be the same value as above
