{
  "name": "replbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-to-Replit MCP bridge with a secure workspace agent.",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test --test-concurrency=1 test/e2e.test.mjs",
    "lint": "npm run format:check",
    "dev:agent": "npm run dev --workspace=packages/workspace-agent",
    "dev:mcp": "npm run dev --workspace=packages/mcp-server",
    "doctor": "node packages/cli/dist/index.js doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:skill": "node scripts/package-skill.mjs"
  },
  "workspaces": [
    "packages/workspace-agent",
    "packages/mcp-server",
    "packages/cli",
    "packages/shared"
  ],
  "keywords": [
    "mcp",
    "claude",
    "replit",
    "agent",
    "workspace",
    "developer-tools",
    "ai-coding"
  ],
  "author": "Alex Santos",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-saint/replbridge.git"
  },
  "homepage": "https://github.com/al-saint/replbridge#readme",
  "bugs": {
    "url": "https://github.com/al-saint/replbridge/issues"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "prettier": "^3.9.10"
  }
}
