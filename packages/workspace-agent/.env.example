# ReplBridge Workspace Agent — on Replit, set these in Secrets instead of a file.

# A secure random token (≥16 chars) Claude must present on every request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPLBRIDGE_PROJECT_TOKEN=replace-with-a-secure-random-token

# Absolute path to the workspace Claude may access.
# On Replit this is /home/runner/workspace
REPLBRIDGE_WORKSPACE_ROOT=/home/runner/workspace

# Port the agent listens on (default 3000)
PORT=3000

# Optional
# HOST=0.0.0.0
# REPLBRIDGE_COMMAND_TIMEOUT_MS=120000
# REPLBRIDGE_EXTRA_COMMANDS=npx tsc --noEmit,npm run e2e
