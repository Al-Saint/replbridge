{
  "name": "@replbridge/cli",
  "version": "0.1.0",
  "description": "ReplBridge CLI — initialize ReplBridge inside any Replit project.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "replbridge": "dist/index.js",
    "replbridge-init": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "author": "Alex Santos",
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude",
    "replit",
    "cli",
    "installer"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/al-saint/replbridge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/al-saint/replbridge#readme",
  "bugs": {
    "url": "https://github.com/al-saint/replbridge/issues"
  }
