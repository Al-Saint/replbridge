# ReplBridge MCP Server — environment variables
# Copy this to .env (in this folder) and fill in your values. Never commit .env.
# Values set in your MCP client's "env" block take precedence over this file.

# The public URL of the Workspace Agent running in your Replit workspace
# (the Repl's dev URL, shown in the Webview / Networking pane).
REPLBRIDGE_AGENT_URL=https://your-repl-dev-url.replit.dev

# Must match REPLBRIDGE_PROJECT_TOKEN in your Replit Secrets (≥16 characters).
REPLBRIDGE_PROJECT_TOKEN=replace-with-your-secure-token

# Optional timeouts (milliseconds)
# REPLBRIDGE_TIMEOUT_MS=30000
# REPLBRIDGE_COMMAND_TIMEOUT_MS=150000
