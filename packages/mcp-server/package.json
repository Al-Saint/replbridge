{
  "name": "@replbridge/mcp-server",
  "version": "0.1.0",
  "description": "ReplBridge MCP server — connects Claude to the ReplBridge Workspace Agent running inside a Replit project.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "replbridge-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "mcp",
    "claude",
    "replit",
    "agent",
    "developer-tools",
    "ai-coding"
  ],
  "author": "Alex Santos",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.12"
  }
}
